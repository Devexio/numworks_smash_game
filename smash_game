# Fonction blocs
def block_fall(n,ran):
  fill_rect(ran,n,25,25,(255,255,255))
  n=n+1
  fill_rect(ran,n,25,25,(0,0,0))
  
# Fonction personnage  
def char(posx):

  if posx < 0:
    fill_rect(posx,200,25,25,(255,255,255))
    posx=0
    fill_rect(posx,200,25,25,"orange")
  elif posx > 295:
    fill_rect(posx,200,25,25,(255,255,255))
    posx=295
    fill_rect(posx,200,25,25,"orange")
  else:       
    if keydown(KEY_LEFT):
      if posx <= 295:
        fill_rect(posx,200,25,25,(255,255,255))
        posx=posx-2
        fill_rect(posx,200,25,25,"orange")
      elif posx > 295:
        fill_rect(posx,200,25,25,(255,255,255))
        posx=295
        fill_rect(posx,200,25,25,"orange")   
    elif keydown(KEY_RIGHT):
        if posx >= 0: 
          fill_rect(posx,200,25,25,(255,255,255))
          posx=posx+2
          fill_rect(posx,200,25,25,"orange")
        elif posx < 0:
          fill_rect(posx,200,25,25,(255,255,255))
          posx=0
          fill_rect(posx,200,25,25,"orange")
    
  return posx
         
